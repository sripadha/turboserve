# syntax=docker/dockerfile:1.7
#
# turboserve gateway image: the OpenAI-compatible multi-tenant API.
#
# The gateway itself never touches a GPU -- it fronts backends (in-process reference
# engine, a remote OpenAI-compatible server such as vLLM, or the mock used by the kind
# e2e and chaos jobs). It is therefore built on a slim CPU base with the CPU build of
# torch, which keeps the image ~10x smaller than the CUDA one.
#
# Build:  make docker-build            (docker build -f Dockerfile.gateway -t turboserve-gateway:dev .)
# Run:    docker run --rm turboserve-gateway:dev            # default CMD: hwinfo
#
# The default CMD is `hwinfo` because that is a command the CLI actually has: `cli.py`
# registers `version` and `hwinfo` only. The gateway's own `serve` sub-application is
# mounted by the `gateway/` owner; until it lands, `turboserve serve` exits 2, so it must
# not be this image's default. Once `serve` is registered the server is started with
#
#     docker run --rm -p 8000:8000 turboserve-gateway:dev serve --engine mock
#
# and the CMD at the bottom of this file changes to that argument list.

FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/turboserve

WORKDIR /build

COPY pyproject.toml uv.lock README.md LICENSE ./

# torch is pinned to the `pytorch-cu124` named index in pyproject.toml, which is
# `explicit = true` so that only torch is taken from it. This image carries no CUDA
# runtime, so the same explicit index is repointed at the CPU wheels. Keeping the edit in
# the file (instead of passing UV_INDEX) preserves `explicit = true`: an index supplied
# through UV_INDEX is not explicit, and uv's first-index strategy would then source and
# downgrade every unrelated package that download.pytorch.org happens to carry. The edit
# invalidates the committed CUDA lock, hence no `--frozen` on the syncs below.
RUN sed -i 's|download.pytorch.org/whl/cu124|download.pytorch.org/whl/cpu|' pyproject.toml

# Dependencies first, so editing source does not re-resolve or re-download wheels.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev --no-install-project

COPY src ./src

# `--no-editable` is required: the default editable install writes a .pth pointing at
# /build/src, which does not exist in the runtime stage, so `turboserve` would die with
# ModuleNotFoundError. This copies the package into the venv instead.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev --no-editable


FROM python:3.12-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="turboserve-gateway" \
      org.opencontainers.image.description="OpenAI-compatible multi-tenant LLM gateway" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/sripadha/turboserve"

ENV PATH=/opt/turboserve/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TURBOSERVE_HOST=0.0.0.0 \
    TURBOSERVE_PORT=8000

RUN groupadd --system --gid 10001 turboserve \
    && useradd --system --uid 10001 --gid 10001 --create-home --home-dir /home/turboserve turboserve

COPY --from=builder --chown=10001:10001 /opt/turboserve /opt/turboserve
COPY --chown=10001:10001 configs /app/configs

WORKDIR /app
USER 10001:10001
EXPOSE 8000

# Applies once the image is run as a server (`serve ...`): Kubernetes probes use /healthz
# and /readyz, and this keeps a plain `docker run -p 8000:8000 ... serve` honest too. With
# the `hwinfo` default CMD the container exits long before the start period elapses, so the
# check never runs.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,os; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ['TURBOSERVE_PORT']}/healthz\").read()"

ENTRYPOINT ["turboserve"]
CMD ["hwinfo"]
